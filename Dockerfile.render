FROM python:3.11-slim

WORKDIR /app

# Sistema básico
RUN apt-get update && apt-get install -y curl unzip && \
    rm -rf /var/lib/apt/lists/* && apt-get clean

# SOLO dependencias esenciales (SIN transformers/torch pesados)
RUN pip install --no-cache-dir \
    fastapi==0.124.0 \
    uvicorn==0.38.0 \
    sqlalchemy==2.0.44 \
    pydantic==2.12.5 \
    pydantic-settings==2.12.0 \
    python-dotenv==1.2.1 \
    requests==2.32.5

# Dependencias básicas para ML mock
RUN pip install --no-cache-dir \
    "numpy<2.0" \
    "scikit-learn>=1.3.0,<1.4.0"

# Código (respeta .dockerignore automáticamente)
COPY Feedback-Classifier/app/ ./app/
COPY Feedback-Classifier/ml_models/ ./ml_models/

# Directorio para modelos
RUN mkdir -p model_files

# CONFIGURACIÓN OPTIMIZADA para Render Free
ENV DATABASE_URL=sqlite:///./feedback.db
ENV PYTHONPATH=/app
ENV SKIP_MODEL_DOWNLOAD=true
ENV DISABLE_ML_MODELS=true
ENV ML_FALLBACK_MODE=true
ENV RENDER_FREE_MODE=true

EXPOSE 8000

# COMANDO optimizado para memoria (1 worker)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
