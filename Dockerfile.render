# feedback-classifier/Dockerfile.render
FROM python:3.11-slim

WORKDIR /app

# Sistema básico + build tools para compilar torch
RUN apt-get update && apt-get install -y \
    curl \
    unzip \
    build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# ✅ DEPENDENCIAS CORE (FastAPI)
RUN pip install --no-cache-dir \
    fastapi==0.124.0 \
    uvicorn==0.38.0 \
    sqlalchemy==2.0.44 \
    pydantic==2.12.5 \
    pydantic-settings==2.12.0 \
    python-dotenv==1.2.1 \
    requests==2.32.5

# ✅ DEPENDENCIAS ML BÁSICAS
RUN pip install --no-cache-dir \
    "numpy<2.0" \
    "scikit-learn>=1.3.0,<1.4.0"

# ✅ TORCH + TRANSFORMERS (CPU-only para cuantización)
RUN pip install --no-cache-dir \
    torch==2.0.1+cpu \
    -f https://download.pytorch.org/whl/torch_stable.html

RUN pip install --no-cache-dir \
    transformers==4.35.2 \
    tokenizers==0.15.0

# Código (respeta .dockerignore automáticamente)
COPY Feedback-Classifier/app/ ./app/
COPY Feedback-Classifier/ml_models/ ./ml_models/

# Directorio para modelos
RUN mkdir -p model_files

# ✅ CONFIGURACIÓN PARA MODELOS CUANTIZADOS
ENV DATABASE_URL=sqlite:///./feedback.db
ENV PYTHONPATH=/app
ENV USE_QUANTIZED_MODELS=true
ENV BACKBLAZE_MODEL_URL=https://your-backblaze-url-here.zip

EXPOSE 8000

# COMANDO optimizado para memoria (1 worker)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
