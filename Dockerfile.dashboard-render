# feedback-classifier/Dockerfile.dashboard-render
FROM python:3.11-slim

WORKDIR /app

# Sistema básico
RUN apt-get update && apt-get install -y curl && \
    rm -rf /var/lib/apt/lists/* && apt-get clean

# SOLO dependencias para Streamlit (SIN ML pesado)
RUN pip install --no-cache-dir \
    streamlit==1.29.0 \
    requests==2.32.5 \
    pandas==2.1.4

# Dashboard code
COPY Feedback-Classifier/dashboard/ ./dashboard/

# Variables optimizadas
ENV API_URL=https://feedback-classifier-api.onrender.com/api/feedback/submit
ENV STREAMLIT_SERVER_PORT=8501
ENV STREAMLIT_SERVER_ADDRESS=0.0.0.0
ENV STREAMLIT_SERVER_HEADLESS=true
ENV STREAMLIT_SERVER_ENABLE_CORS=false

EXPOSE 8501

# Comando para Streamlit
CMD ["streamlit", "run", "dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
