# feedback-classifier/Dockerfile.backblaze
FROM python:3.11-slim

WORKDIR /app

# Sistema básico
RUN apt-get update && apt-get install -y curl unzip && \
    rm -rf /var/lib/apt/lists/* && apt-get clean

# Dependencias básicas
RUN pip install --no-cache-dir \
    fastapi uvicorn sqlalchemy pydantic pydantic-settings \
    python-dotenv requests

# ✅ VERSIONES COMPATIBLES FIJADAS
RUN pip install --no-cache-dir \
    "numpy<2.0" \
    torch==2.1.0+cpu --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir \
    "transformers>=4.30.0,<4.36.0" \
    "pandas>=1.5.0,<2.0.0" \
    "scikit-learn>=1.3.0,<1.4.0"

# Código
COPY Feedback-Classifier/app/ ./app/
COPY Feedback-Classifier/ml_models/ ./ml_models/

# Directorio para modelos
RUN mkdir -p model_files

# Configuración
ENV DATABASE_URL=sqlite:///./feedback.db
ENV PYTHONPATH=/app

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]